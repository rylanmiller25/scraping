# Ignore Data Files
*.parquet
*.dta

# Allow monthly input parquet files to be committed if desired
!Input Data/pb_*.parquet

# Allow scraper raw outputs to be committed
!Output Data/Raw Text Datasets/raw_*.parquet

# Ignore Logs
*.log

# Ignore Python Cache and Environment
__pycache__/
*.pyc
.venv/
env/

# OS specific
.DS_Store

# Keep the directory structure
!Input Data/.gitkeep
!Output Data/Raw Text Datasets/.gitkeep
!Output Data/Analysis Datasets/.gitkeep

